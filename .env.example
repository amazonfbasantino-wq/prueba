# Copiá este archivo como ".env" y completá tus valores.

# Tu API key de Anthropic (obtenela en https://console.anthropic.com/).
# Es lo que le permite a la app leer y resumir los archivos con Claude.
ANTHROPIC_API_KEY=sk-ant-...

# Carpeta que se va a vigilar. Si la dejás vacía, usa tu carpeta de Descargas por defecto.
# Ejemplos:
#   Windows: C:\Users\TU_USUARIO\Downloads
#   macOS:   /Users/TU_USUARIO/Downloads
#   Linux:   /home/TU_USUARIO/Downloads
WATCH_FOLDER=

# Modelo de Claude a usar (opcional).
CLAUDE_MODEL=claude-sonnet-5

# Puerto del servidor web local (opcional).
PORT=5000
